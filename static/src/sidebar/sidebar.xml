<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="erpico_web_sidebar.Sidebar">
        <nav
            t-if="state.ready"
            t-att-class="'o_erpico_sidebar ' + (state.fullscreenHidden ? 'o_erpico_sidebar-fullscreen-hidden' : 'd-none d-lg-flex')"
            aria-label="Aplicaciones ERPICO"
        >
            <!-- Rail -->
            <div class="o_erpico_rail">
                <button
                    type="button"
                    class="o_erpico_rail_logo"
                    aria-label="ERPICO, inicio"
                    t-on-click="() => this.goHome()"
                >
                    <img
                        src="/erpico_web_sidebar/static/src/images/erpico-favicon.png"
                        alt="ERPICO"
                    />
                </button>

                <div class="o_erpico_rail_apps">
                    <t t-foreach="state.entries" t-as="entry" t-key="entry.id">
                        <button
                            type="button"
                            class="o_erpico_rail_btn"
                            t-att-class="{ 'o_active': this.isEntryActive(entry) }"
                            t-att-data-entry="entry.id"
                            t-att-data-xmlids="xmlidsOf(entry)"
                            t-att-title="entry.label"
                            t-att-aria-label="entry.label"
                            t-att-aria-current="this.isEntryActive(entry) ? 'page' : undefined"
                            t-att-aria-expanded="state.flyoutEntry and state.flyoutEntry.id === entry.id ? 'true' : 'false'"
                            aria-controls="erpico-sidebar-flyout"
                            aria-haspopup="menu"
                            t-on-mouseenter="() => this.hoverEntry(entry)"
                            t-on-mouseleave="() => this.clearHover()"
                            t-on-click.stop="() => this.selectEntry(entry)"
                            t-on-keydown="(ev) => this._onRailKeydown(entry, ev)"
                        >
                            <t t-if="entry.icon.kind === 'img'">
                                <img class="o_erpico_rail_icon" t-att-src="entry.icon.src" alt="" />
                            </t>
                            <t t-else="">
                                <svg class="o_erpico_rail_icon o_erpico_rail_svg" aria-hidden="true">
                                    <use t-att-href="entry.icon.src" />
                                </svg>
                            </t>
                        </button>
                    </t>
                </div>

                <div class="o_erpico_rail_footer">
                    <button
                        type="button"
                        class="o_erpico_rail_btn"
                        t-att-class="{ 'o_active': state.allAppsOpen }"
                        title="Todas las aplicaciones"
                        aria-label="Todas las aplicaciones"
                        t-att-aria-expanded="state.allAppsOpen ? 'true' : 'false'"
                        aria-controls="erpico-allapps"
                        t-on-click="() => this.toggleAllApps()"
                    >
                        <svg class="o_erpico_rail_icon o_erpico_rail_svg" aria-hidden="true">
                            <use href="/erpico_web_sidebar/static/src/icons/ui-sprite.svg#i-grid" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Flyout de la entrada en hover -->
            <div
                t-if="state.flyoutEntry and !state.allAppsOpen"
                class="o_erpico_flyout"
                id="erpico-sidebar-flyout"
                role="menu"
                t-on-mouseenter="() => this._onFlyoutEnter()"
                t-on-mouseleave="() => this._onFlyoutLeave()"
            >
                <div class="o_erpico_flyout_header">
                    <strong t-esc="state.flyoutEntry.label"/>
                    <button
                        type="button"
                        class="o_erpico_flyout_link"
                        t-on-click.stop="() => this.selectEntry(state.flyoutEntry)"
                    >
                        <span>Ir a la app</span>
                        <svg class="o_erpico_flyout_arrow" aria-hidden="true">
                            <use href="/erpico_web_sidebar/static/src/icons/ui-sprite.svg#i-arrow" />
                        </svg>
                    </button>
                </div>
                <t t-foreach="state.flyoutEntry.sections" t-as="section" t-key="section.label">
                    <span
                        t-if="section.childrenTree.length and state.flyoutEntry.sections.length > 1"
                        class="o_erpico_flyout_group"
                        t-esc="section.label"
                    />
                    <ul class="o_erpico_flyout_menu">
                        <t t-call="erpico_web_sidebar.FlyoutMenu">
                            <t
                                t-set="items"
                                t-value="section.childrenTree.length ? section.childrenTree : (section.leaf ? [section.leaf] : [])"
                            />
                        </t>
                    </ul>
                </t>
            </div>

            <!-- Panel "Todas las aplicaciones" -->
            <div t-if="state.allAppsOpen" id="erpico-allapps" class="o_erpico_allapps" role="dialog" aria-label="Todas las aplicaciones">
                <div class="o_erpico_flyout_header">
                    <strong>Todas las aplicaciones</strong>
                </div>
                <ul class="o_erpico_allapps_grid">
                    <t t-foreach="allAppsList" t-as="app" t-key="app.id">
                        <li>
                            <t t-set="icon" t-value="this.iconFor(app)"/>
                            <t t-if="icon.kind === 'img'">
                                <img class="o_erpico_allapps_icon" t-att-src="icon.src" alt="" />
                            </t>
                            <t t-else="">
                                <svg class="o_erpico_allapps_icon" aria-hidden="true">
                                    <use t-att-href="icon.src" />
                                </svg>
                            </t>
                            <span t-esc="app.name"/>
                            <button
                                type="button"
                                class="o_erpico_allapps_open"
                                aria-label="Abrir"
                                t-on-click.stop="() => this.openApp(app)"
                            />
                        </li>
                    </t>
                </ul>
            </div>
        </nav>

        <!-- Drawer móvil -->
        <t t-if="state.drawerOpen">
            <div class="o_erpico_backdrop" t-on-click="(ev) => this._closeDrawerFromBackdrop(ev)" />
            <nav class="o_erpico_drawer" t-ref="drawer" role="dialog" aria-modal="true" aria-label="Aplicaciones ERPICO">
                <div class="o_erpico_drawer_header">
                    <img
                        src="/erpico_web_sidebar/static/src/images/erpico-logo-horizontal.png"
                        alt="ERPICO"
                        class="o_erpico_drawer_logo"
                    />
                    <button
                        type="button"
                        class="o_erpico_drawer_close"
                        data-autofocus="true"
                        t-on-click="() => this._closeDrawer()"
                        aria-label="Cerrar menú"
                    >
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_erpico_drawer_apps">
                    <t t-foreach="state.entries" t-as="entry" t-key="entry.id">
                        <div class="o_erpico_drawer_app">
                            <button
                                type="button"
                                class="o_erpico_drawer_app_btn"
                                t-att-class="{ 'o_active': this.isEntryActive(entry) }"
                                t-att-data-entry="entry.id"
                                t-on-click="() => this.selectEntry(entry)"
                            >
                                <t t-if="entry.icon.kind === 'img'">
                                    <img class="o_erpico_drawer_icon" t-att-src="entry.icon.src" alt="" />
                                </t>
                                <t t-else="">
                                    <svg class="o_erpico_drawer_icon" aria-hidden="true">
                                        <use t-att-href="entry.icon.src" />
                                    </svg>
                                </t>
                                <span t-esc="entry.label"/>
                            </button>
                            <t t-foreach="entry.sections" t-as="section" t-key="section.label">
                                <span
                                    t-if="section.childrenTree.length and entry.sections.length > 1"
                                    class="o_erpico_drawer_group"
                                    t-esc="section.label"
                                />
                                <t t-if="section.childrenTree.length or section.leaf">
                                    <t t-call="erpico_web_sidebar.DrawerMenu">
                                        <t
                                            t-set="items"
                                            t-value="section.childrenTree.length ? section.childrenTree : [section.leaf]"
                                        />
                                        <t t-set="activeId" t-value="section.leaf ? section.leaf.id : 0"/>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>

                <t t-if="drawerOtherApps.length">
                    <div class="o_erpico_drawer_allapps">
                        <button
                            type="button"
                            class="o_erpico_drawer_allapps_toggle"
                            t-att-aria-expanded="state.drawerAllAppsOpen ? 'true' : 'false'"
                            aria-controls="erpico-drawer-allapps"
                            t-on-click="() => this.toggleDrawerAllApps()"
                        >
                            <i class="fa fa-th" aria-hidden="true"/>
                            <span>Todas las aplicaciones</span>
                        </button>
                        <ul t-if="state.drawerAllAppsOpen" id="erpico-drawer-allapps" class="o_erpico_drawer_allapps_list">
                            <t t-foreach="drawerOtherApps" t-as="app" t-key="app.id">
                                <li><button type="button" t-on-click="() => this.openApp(app)" t-esc="app.name"/></li>
                            </t>
                        </ul>
                    </div>
                </t>

                <div class="o_erpico_drawer_footer">
                    <SwitchCompanyMenu />
                    <button
                        t-if="canAccessSettings"
                        type="button"
                        class="o_erpico_drawer_settings"
                        t-on-click="() => this.goToSettings()"
                    >
                        <i class="fa fa-cog" aria-hidden="true"/>
                        <span>Ajustes</span>
                    </button>
                </div>
            </nav>
        </t>
    </t>

    <t t-name="erpico_web_sidebar.FlyoutMenu">
        <t t-foreach="items" t-as="item" t-key="item.id">
            <li t-if="!item.childrenTree.length">
                <button
                    type="button"
                    class="o_erpico_flyout_item"
                    t-on-click.stop="() => this.openItem(item)"
                    t-esc="item.name"
                />
            </li>
            <li t-else="">
                <span class="o_erpico_flyout_group" t-esc="item.name"/>
                <ul class="o_erpico_flyout_sub">
                    <t t-call="erpico_web_sidebar.FlyoutMenu">
                        <t t-set="items" t-value="item.childrenTree"/>
                    </t>
                </ul>
            </li>
        </t>
    </t>

    <!--
        Gemelo del FlyoutMenu para el drawer móvil. Es recursivo por la misma
        razón que el flyout (D-13): los nodos "Reporting" cuelgan dos niveles
        abajo del root de cada app, y un drawer de un solo nivel los dejaba
        inalcanzables — el usuario veía "Reporting" como un único ítem que
        abría el primer reporte y no podía llegar a los demás.

        `activeId` es el id de la hoja alcanzable de la sección y sólo pinta el
        `o_active` del primer nivel. Se re-declara en cada llamada, incluso en la
        recursiva, para que el compilador de QWeb lo tenga como variable conocida
        en todos los niveles: si se dejara sin declarar en la recursión y OWL no
        compartiera el contexto entre `t-call`, la expresión caería sobre un
        identificador inexistente. El valor fluye porque el `t-set` se compila
        sobre el contexto del template, así que la reasignación es un no-op.
    -->
    <t t-name="erpico_web_sidebar.DrawerMenu">
        <ul class="o_erpico_drawer_sub">
            <t t-foreach="items" t-as="item" t-key="item.id">
                <li t-if="!item.childrenTree.length" t-att-class="{ 'o_active': activeId ? activeId === item.id : false }">
                    <button type="button" t-on-click="() => this.openItem(item)" t-esc="item.name"/>
                </li>
                <li t-else="" class="o_erpico_drawer_group_item">
                    <span class="o_erpico_drawer_subgroup" t-esc="item.name"/>
                    <t t-call="erpico_web_sidebar.DrawerMenu">
                        <t t-set="items" t-value="item.childrenTree"/>
                        <t t-set="activeId" t-value="activeId"/>
                    </t>
                </li>
            </t>
        </ul>
    </t>

</templates>
